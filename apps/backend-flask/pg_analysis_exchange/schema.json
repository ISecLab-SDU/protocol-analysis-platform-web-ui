{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protocolguard:analysis:1",
  "title": "ProtocolGuard portable analysis document",
  "type": "object",
  "properties": {
    "format": {
      "const": "protocolguard.analysis"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "archiveName": {
          "type": "string",
          "minLength": 1
        },
        "treeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "archiveName",
        "treeSha256",
        "files"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requestTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "requestFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "responseTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "responseFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "description",
              "reference",
              "requestTypes",
              "requestFields",
              "responseTypes",
              "responseFields"
            ]
          },
          "verdict": {
            "enum": [
              "compliant",
              "non_compliant",
              "needs_review"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "function": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "relevantLines": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "path",
                "function",
                "startLine",
                "endLine",
                "relevantLines",
                "code"
              ]
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "codeSlice": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "callGraph": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "codeSlice",
              "callGraph"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/diagnostic"
            }
          }
        },
        "required": [
          "id",
          "rule",
          "verdict",
          "reason",
          "locations",
          "context",
          "diagnostics"
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "analysisId",
    "generatedAt",
    "producer",
    "protocol",
    "source",
    "results",
    "diagnostics"
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "warning",
            "blocking"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "resultId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    }
  }
}
